# 모듈 1 대조 쌍 생성 — 강한 생성 모델 설정 (OpenAI)
# 이 파일은 템플릿(커밋 대상). 실제 키는 절대 여기 넣지 말고 .env 에만 둘 것.
OPENAI_API_KEY=sk-...

# 생성 모델 (프런티어 권장). mini 금지(minimal-edit 제약 미준수). 미설정 시 gpt-4o.
GEN_MODEL=gpt-5.5

# 샘플링 온도. 변형 다양성을 위해 약간 높게(0.7~0.9) 권장. 미설정 시 0.8.
# 주의: gpt-5 계열은 temperature 커스텀값을 거부(기본 1 고정)하므로 이 값은 무시됨.
GEN_TEMPERATURE=0.8

# ── 모듈 2 검증 스크리닝 (screen_pairs.py) ──
# 생성(GPT)과 다른 Claude 계열로 교차 검증(self-preference 편향 방지).
ANTHROPIC_API_KEY=sk-ant-...
# 판정 모델. 미설정 시 claude-opus-4-8. 비용 절감: claude-sonnet-5.
# claude* → Anthropic 판정, 그 외(gpt-4o 등) → OpenAI 판정.
JUDGE_MODEL=claude-opus-4-8

# ── 모듈 3+ 벡터 추출 (steering/, Gemma 2 2B) ──
# Gemma 는 HF 게이트 모델 → huggingface.co 에서 라이선스 수락 후 토큰 발급.
HF_TOKEN=hf_...
